#!/bin/sh
# Read-only status. Never probes NAS paths which can block on NFS I/O.
printf 'Home router candidate 0.1.0-rc1\n'
date
uptime
printf '\nMemory\n'
free -m
printf '\nLocal filesystems (network mounts excluded)\n'
df -h -l
printf '\nConfigured mounts\n'
awk '$3 ~ /^(nfs|nfs4|cifs|fuse.rclone)$/ {print $1, $2, $3}' /proc/mounts
printf '\nEnabled services (not a business health assertion)\n'
for name in dockerd zerotier adguardhome transmission passwall2 p910nd miniupnpd home-child-policy; do
	if [ -x "/etc/init.d/$name" ]; then
		if "/etc/init.d/$name" enabled; then printf '%s: enabled\n' "$name"; else printf '%s: disabled/unconfigured\n' "$name"; fi
	fi
done
printf '\nChild rule status\n'
nft list table inet home_child 2>/dev/null || true
