#!/bin/sh /etc/rc.common
START=95
USE_PROCD=1
start_service() {
	[ "$(uci -q get homerouter.child.enabled)" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /bin/sh -c 'while :; do /usr/sbin/home-child-policy apply; sleep 15; done'
	procd_set_param respawn 3600 10 3
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
stop_service() {
	/usr/sbin/home-child-policy remove
}
service_triggers() {
	procd_add_reload_trigger homerouter
}
