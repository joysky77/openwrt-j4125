#!/bin/sh /etc/rc.common
START=96
USE_PROCD=1
start_service() {
	[ "$(uci -q get homerouter.nas.enabled)" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/home-nas-watch
	procd_set_param respawn 3600 30 3
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
service_triggers() {
	procd_add_reload_trigger homerouter
}
