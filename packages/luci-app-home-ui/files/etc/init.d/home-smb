#!/bin/sh /etc/rc.common
START=95
STOP=10
USE_PROCD=1
start_service() {
	[ "$(uci -q get homesmb.nas.enabled)" = 1 ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/home-smb worker
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}
service_stopped() {
	/usr/sbin/home-smb unmount >/dev/null 2>&1 || true
}
reload_service() {
	# A source or credential change needs a real remount, not only procd's
	# comparison of the unchanged worker command line.
	stop
	start
}
service_triggers() {
	procd_add_reload_trigger homesmb
}
